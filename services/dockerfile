
FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy project files
COPY . .

# API port inside the container
EXPOSE 8000

# Start FastAPI
CMD ["uvicorn", "services.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
