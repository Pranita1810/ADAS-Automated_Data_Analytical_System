# API Gateway Settings
API_URL="http://api:8000/maindata"
API_USERNAME="Pranit"
API_PASSWORD="Nothing"

# Backup Settings (Docker & Local paths)
BACKUP_DIR="backups/parquet_backups"

# Microsoft SQL Server / SSMS Configuration
# When running inside Docker, host.docker.internal reaches the host SSMS instance.
# When running locally on Windows, localhost or host.docker.internal can be used.
MSSQL_HOST="host.docker.internal"
MSSQL_PORT=1433
MSSQL_DATABASE="test"
MSSQL_USER=""
MSSQL_PASSWORD=""
MSSQL_DRIVER="ODBC Driver 18 for SQL Server"
MSSQL_TRUSTED_CONNECTION="yes"
MSSQL_TRUST_SERVER_CERTIFICATE="yes"
MSSQL_TABLE="sales_analytics"
